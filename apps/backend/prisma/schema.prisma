generator client {
  provider        = "prisma-client-js"
  // output       = "../../generated/prisma"
  // output       = "./node_modules/.prisma/client"
  output          = "../../../node_modules/.prisma/client"
  // output       = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int            @id @default(autoincrement())
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  username         String
  email            String         @unique
  password         String?
  block_expires_at DateTime?
  google_id        String?        @unique
  role             UserRole       @default(USER)
  refresh_tokens   RefreshToken[]
  comments         Comment[]
  contacts         Contact[]
  user_movies      UserMovie[]
  otps             Otp[]
  login_requests   LoginRequest[]
  commentVotes     CommentVote[]

  @@map("users")
}

model Movie {
  id             Int                @id @default(autoincrement())
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt
  type           MovieType
  slug           String             @unique
  age_limit      Int?
  released_year  Int
  likes_count    Int                @default(0)
  dislikes_count Int                @default(0)
  watches_count  Int                @default(0)
  episodes       Episode[]
  factors        MovieFactor[]
  translations   MovieTranslation[]
  seasons        Season[]
  user_movies    UserMovie[]
  files          MovieFile[]
  genres         MovieGenre[]
  languages      MovieLanguage[]
  countries      MovieCountry[]
  tags           MovieTag[]
  section_movies SectionMovie[]
  comments       Comment[]

  @@map("movies")
}

model MovieFile {
  id        Int           @id @default(autoincrement())
  movie_id  Int
  upload_id Int
  type      MovieFileType
  movie     Movie         @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  upload    Upload        @relation(fields: [upload_id], references: [id], onDelete: Cascade)

  @@map("movie_files")
}

model MovieTranslation {
  id                Int         @id @default(autoincrement())
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
  title             String
  short_description String
  description       String
  language          AppLanguage
  movie_id          Int
  movie             Movie       @relation(fields: [movie_id], references: [id], onDelete: Cascade)

  @@map("movie_translations")
}

model MovieLanguage {
  id          Int      @id @default(autoincrement())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  movie_id    Int
  language_id Int
  movie       Movie    @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  language    Language @relation(fields: [language_id], references: [id], onDelete: Cascade)

  @@map("movie_languages")
}

model Country {
  id              Int                  @id @default(autoincrement())
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  code            String               @unique
  translations    CountryTranslation[]
  movie_countries MovieCountry[]

  @@map("countries")
}

model CountryTranslation {
  id         Int         @id @default(autoincrement())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  label      String
  language   AppLanguage
  country_id Int
  country    Country     @relation(fields: [country_id], references: [id], onDelete: Cascade)

  @@map("country_translations")
}

model MovieCountry {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  movie_id   Int
  country_id Int
  movie      Movie    @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  country    Country  @relation(fields: [country_id], references: [id], onDelete: Cascade)

  @@map("movie_countries")
}

model Language {
  id              Int                   @id @default(autoincrement())
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  code            String                @unique
  translations    LanguageTranslation[]
  movie_languages MovieLanguage[]

  @@map("languages")
}

model LanguageTranslation {
  id          Int         @id @default(autoincrement())
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  label       String
  lang        AppLanguage
  language_id Int
  language    Language    @relation(fields: [language_id], references: [id], onDelete: Cascade)

  @@map("language_translations")
}

model Season {
  id           Int                 @id @default(autoincrement())
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt
  order        Int
  slug         String              @unique
  movie_id     Int
  episodes     Episode[]
  translations SeasonTranslation[]
  movie        Movie               @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  files        SeasonFile[]

  @@map("seasons")
}

model SeasonFile {
  id        Int            @id @default(autoincrement())
  season_id Int
  upload_id Int
  type      SeasonFileType
  season    Season         @relation(fields: [season_id], references: [id], onDelete: Cascade)
  upload    Upload         @relation(fields: [upload_id], references: [id], onDelete: Cascade)

  @@map("season_files")
}

model SeasonTranslation {
  id         Int         @id @default(autoincrement())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  title      String
  season_id  Int
  language   AppLanguage
  season     Season      @relation(fields: [season_id], references: [id], onDelete: Cascade)

  @@map("season_translation")
}

model Episode {
  id             Int                  @id @default(autoincrement())
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  order          Int
  slug           String               @unique
  season_id      Int
  movie_id       Int
  likes_count    Int                  @default(0)
  dislikes_count Int                  @default(0)
  watches_count  Int                  @default(0)
  translations   EpisodeTranslation[]
  movie          Movie                @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  season         Season               @relation(fields: [season_id], references: [id], onDelete: Cascade)
  files          EpisodeFile[]
  user_movies    UserMovie[]
  comments       Comment[]

  @@map("episodes")
}

model EpisodeFile {
  id         Int             @id @default(autoincrement())
  episode_id Int
  upload_id  Int
  type       EpisodeFileType
  upload     Upload          @relation(fields: [upload_id], references: [id], onDelete: Cascade)
  episode    Episode         @relation(fields: [episode_id], references: [id], onDelete: Cascade)

  @@map("episode_files")
}

model EpisodeTranslation {
  id                Int         @id @default(autoincrement())
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
  title             String
  short_description String
  episode_id        Int
  language          AppLanguage
  episode           Episode     @relation(fields: [episode_id], references: [id], onDelete: Cascade)

  @@map("episode_translations")
}

model Comment {
  id             Int               @id @default(autoincrement())
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
  likes_count    Int               @default(0)
  dislikes_count Int               @default(0)
  status         CommentStatus     @default(PENDING)
  entity_type    CommentEntityType
  movie_id       Int
  episode_id     Int?
  body           String
  user_id        Int
  // parent_id      Int?
  // parent         Comment?          @relation("CommentToReplies", fields: [parent_id], references: [id])
  // replies        Comment[]         @relation("CommentToReplies")
  movie          Movie             @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  episode        Episode?          @relation(fields: [episode_id], references: [id], onDelete: Cascade)
  votes          CommentVote[]
  user           User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("comments")
}

model CommentVote {
  id          Int               @id @default(autoincrement())
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  comment_id  Int
  user_id     Int
  vote_status CommentVoteStatus
  user        User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  comment     Comment           @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  @@map("comment_votes")
}

model Factor {
  id            Int                 @id @default(autoincrement())
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt
  translations  FactorTranslation[]
  movie_factors MovieFactor[]
  slug          String              @unique
  files         FactorFile[]

  @@map("factors")
}

model FactorFile {
  id        Int            @id @default(autoincrement())
  factor_id Int
  upload_id Int
  type      FactorFileType
  factor    Factor?        @relation(fields: [factor_id], references: [id], onDelete: Cascade)
  upload    Upload         @relation(fields: [upload_id], references: [id], onDelete: Cascade)

  @@map("factor_files")
}

model FactorTranslation {
  id         Int         @id @default(autoincrement())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  first_name String
  last_name  String
  language   AppLanguage
  factor_id  Int
  factor     Factor      @relation(fields: [factor_id], references: [id], onDelete: Cascade)

  @@map("factor_translations")
}

model MovieFactor {
  id           Int                      @id @default(autoincrement())
  created_at   DateTime                 @default(now())
  updated_at   DateTime                 @updatedAt
  movie_id     Int
  factor_id    Int
  role_id      Int
  order        Int
  factor       Factor                   @relation(fields: [factor_id], references: [id], onDelete: Cascade)
  movie        Movie                    @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  role         Role                     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  translations MovieFactorTranslation[]

  @@unique([movie_id, order])
  @@map("movie_factors")
}

model MovieFactorTranslation {
  id              Int         @id @default(autoincrement())
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  role_name       String
  movie_factor_id Int
  language        AppLanguage
  movie_factor    MovieFactor @relation(fields: [movie_factor_id], references: [id], onDelete: Cascade)

  @@map("movie_factor_translations")
}

model Role {
  id            Int               @id @default(autoincrement())
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  slug          String            @unique
  type          RoleType
  movie_factors MovieFactor[]
  translations  RoleTranslation[]

  @@map("roles")
}

model RoleTranslation {
  id         Int         @id @default(autoincrement())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  name       String
  role_id    Int
  language   AppLanguage
  role       Role        @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@map("role_translations")
}

model Genre {
  id           Int                @id @default(autoincrement())
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  slug         String             @unique
  translations GenreTranslation[]
  movies       MovieGenre[]

  @@map("genres")
}

model GenreTranslation {
  id         Int         @id @default(autoincrement())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  name       String
  genre_id   Int
  language   AppLanguage
  genre      Genre       @relation(fields: [genre_id], references: [id], onDelete: Cascade)

  @@map("genre_translations")
}

model MovieGenre {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  genre_id   Int
  movie_id   Int
  genre      Genre    @relation(fields: [genre_id], references: [id], onDelete: Cascade)
  movie      Movie    @relation(fields: [movie_id], references: [id], onDelete: Cascade)

  @@map("movie_genres")
}

model Tag {
  id           Int              @id @default(autoincrement())
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  slug         String           @unique
  translations TagTranslation[]
  movie_tags   MovieTag[]

  @@map("tags")
}

model TagTranslation {
  id         Int         @id @default(autoincrement())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  label      String
  language   AppLanguage
  tag_id     Int
  tag        Tag         @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@map("tag_translations")
}

model MovieTag {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  tag_id     Int
  movie_id   Int
  tag        Tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  movie      Movie    @relation(fields: [movie_id], references: [id], onDelete: Cascade)

  @@map("movie_tags")
}

model Section {
  id              Int                  @id @default(autoincrement())
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  slug            String               @unique
  order           Int                  @unique
  view_mode       SectionViewMode
  selection_mode  SectionSelectionMode
  sort_mode       SectionSortMode?
  period_base     SectionPeriodBase?
  translations    SectionTranslation[]
  section_movies  SectionMovie[]
  section_filters SectionFilter[]

  @@map("sections")
}

model SectionFilter {
  id           Int              @id @default(autoincrement())
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  section_id   Int
  filter_key   SectionFilterKey
  filter_value String
  section      Section          @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@map("section_filters")
}

model SectionTranslation {
  id          Int         @id @default(autoincrement())
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  title       String
  description String?
  language    AppLanguage
  section_id  Int
  section     Section     @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@map("section_translations")
}

model SectionMovie {
  id         Int                   @id @default(autoincrement())
  created_at DateTime              @default(now())
  updated_at DateTime              @updatedAt
  section_id Int
  movie_id   Int
  order      Int
  view_mode  SectionMovieViewMode?
  section    Section               @relation(fields: [section_id], references: [id], onDelete: Cascade)
  movie      Movie                 @relation(fields: [movie_id], references: [id], onDelete: Cascade)

  @@unique([section_id, movie_id, order])
  @@map("section_movies")
}

model UserMovie {
  id            Int               @id @default(autoincrement())
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  type          UserMovieType
  progress_time Int?
  user_id       Int
  movie_id      Int?
  episode_id    Int?
  entity_type   CommentEntityType
  movie         Movie?            @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  episode       Episode?          @relation(fields: [episode_id], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_movies")
}

model Upload {
  id            Int           @id @default(autoincrement())
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  path          String
  mime_type     String
  file_name     String?
  source_type   SourceType
  alt_text      String?
  size          Int?
  width         String?
  height        String?
  duration      String?
  movie_files   MovieFile[]
  season_files  SeasonFile[]
  episode_files EpisodeFile[]
  factor_files  FactorFile[]

  @@map("uploads")
}

model Contact {
  id         Int           @id @default(autoincrement())
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  subject    String?
  body       String
  parent_id  Int?
  status     ContactStatus @default(PENDING)
  user_id    Int
  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model RefreshToken {
  id             Int      @id @default(autoincrement())
  user_id        Int
  hashed_refresh String
  created_at     DateTime @default(now())
  expires_at     DateTime
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Otp {
  id           Int       @id @default(autoincrement())
  user_id      Int?
  user_email   String?
  hashed_otp   String
  created_at   DateTime  @default(now())
  used_at      DateTime?
  expires_at   DateTime
  otp_attempts Int       @default(0)
  type         OtpType
  user         User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@index([user_id, used_at])
  @@map("otps")
}

model LoginRequest {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("login_requests")
}

enum UserRole {
  USER
  ADMIN
}

enum MovieType {
  CINEMATIC
  SERIES
}

enum AppLanguage {
  FA
  EN
  AR
}

enum CommentStatus {
  APPROVED
  REJECTED
  PENDING
}

enum CommentEntityType {
  MOVIE
  EPISODE
}

enum UserMovieType {
  BOOKMARK
  LIKE
  DISLIKE
  WATCHING
  WATCHED
}

enum ContactStatus {
  PENDING
  APPROVED
}

enum MovieFileType {
  POSTER
  BANNER
  THUMBNAIL
  TRAILER
  FILM
}

enum SeasonFileType {
  POSTER
  TRAILER
}

enum EpisodeFileType {
  POSTER
  TRAILER
  COVER
  FILM
}

enum FactorFileType {
  PROFILE
}

enum OtpType {
  LOGIN
  FORGET_PASSWORD
  SIGNUP
}

enum SourceType {
  FROM_FILE
  FROM_URL
}

enum RoleType {
  CREATOR
  ACTOR
}

enum SectionSelectionMode {
  AUTO
  USER_MOVIE
  MANUAL
}

enum SectionViewMode {
  HERO
  NORMAL_SLIDER
  KIDS_SLIDER
  HERO_LIKE_SLIDER
  PUZZLE
  ADVERTISEMENT
}

enum SectionSortMode {
  NEWEST
  OLDEST
  MOST_VIEWED
  TOP_RATED
  TRENDING
  RANDOM
}

enum SectionPeriodBase {
  A_DAY_AGO
  A_WEEK_AGO
  A_MONTH_AGO
}

enum SectionMovieViewMode {
  PUZZLE
  SLIDER_ITEM
}

enum SectionFilterKey {
  SEARCH
  GENRES
  AGE_LIMITS
  COUNTRIES
  TAGS
  LANGUAGES
  TYPE
  RELEASED_YEAR_FROM
  RELEASED_YEAR_TO
}

enum CommentVoteStatus {
  LIKE
  DISLIKE
}
