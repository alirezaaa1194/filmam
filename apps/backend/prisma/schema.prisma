generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["views"]
  moduleFormat    = "cjs"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                 Int                @id @default(autoincrement())
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  username           String
  email              String             @unique
  password           String?
  role               UserRole           @default(USER)
  block_expires_at   DateTime?
  google_id          String?            @unique
  preferred_language AppLanguage        @default(EN)
  commentVotes       CommentVote[]
  comments           Comment[]
  login_requests     LoginRequest[]
  otps               Otp[]
  pushSubscriptions  PushSubscription[]
  refresh_tokens     RefreshToken[]
  user_movies        UserMovie[]

  @@map("users")
}

model Movie {
  id             Int                @id @default(autoincrement())
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt
  type           MovieType
  slug           String             @unique
  age_limit      Int?
  released_year  Int
  likes_count    Int                @default(0)
  watches_count  Int                @default(0)
  dislikes_count Int                @default(0)
  combined_tags  String
  imdb_score     Float
  has_dub        Boolean            @default(false)
  comments       Comment[]
  episodes       Episode[]
  countries      MovieCountry[]
  factors        MovieFactor[]
  files          MovieFile[]
  genres         MovieGenre[]
  languages      MovieLanguage[]
  tags           MovieTag[]
  translations   MovieTranslation[]
  seasons        Season[]
  section_movies SectionMovie[]
  user_movies    UserMovie[]

  @@map("movies")
}

model MovieFile {
  id               Int           @id @default(autoincrement())
  movie_id         Int
  upload_id        Int
  type             MovieFileType
  intro_duration   Int?
  intro_start_time Int?
  outro_duration   Int?
  movie            Movie         @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  upload           Upload        @relation(fields: [upload_id], references: [id], onDelete: Cascade)

  @@map("movie_files")
}

model MovieTranslation {
  id                Int         @id @default(autoincrement())
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
  title             String
  short_description String
  description       String
  language          AppLanguage
  movie_id          Int
  movie             Movie       @relation(fields: [movie_id], references: [id], onDelete: Cascade)

  @@map("movie_translations")
}

model MovieLanguage {
  id          Int      @id @default(autoincrement())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  movie_id    Int
  language_id Int
  language    Language @relation(fields: [language_id], references: [id], onDelete: Cascade)
  movie       Movie    @relation(fields: [movie_id], references: [id], onDelete: Cascade)

  @@map("movie_languages")
}

model Country {
  id              Int                  @id @default(autoincrement())
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  code            String               @unique
  translations    CountryTranslation[]
  movie_countries MovieCountry[]

  @@map("countries")
}

model CountryTranslation {
  id         Int         @id @default(autoincrement())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  label      String
  country_id Int
  language   AppLanguage
  country    Country     @relation(fields: [country_id], references: [id], onDelete: Cascade)

  @@map("country_translations")
}

model MovieCountry {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  movie_id   Int
  country_id Int
  country    Country  @relation(fields: [country_id], references: [id], onDelete: Cascade)
  movie      Movie    @relation(fields: [movie_id], references: [id], onDelete: Cascade)

  @@map("movie_countries")
}

model Language {
  id              Int                   @id @default(autoincrement())
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  code            String                @unique
  translations    LanguageTranslation[]
  movie_languages MovieLanguage[]

  @@map("languages")
}

model LanguageTranslation {
  id          Int         @id @default(autoincrement())
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  label       String
  lang        AppLanguage
  language_id Int
  language    Language    @relation(fields: [language_id], references: [id], onDelete: Cascade)

  @@map("language_translations")
}

model Season {
  id           Int                 @id @default(autoincrement())
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt
  movie_id     Int
  order        Int
  slug         String              @unique
  episodes     Episode[]
  files        SeasonFile[]
  translations SeasonTranslation[]
  movie        Movie               @relation(fields: [movie_id], references: [id], onDelete: Cascade)

  @@map("seasons")
}

model SeasonFile {
  id        Int            @id @default(autoincrement())
  season_id Int
  upload_id Int
  type      SeasonFileType
  season    Season         @relation(fields: [season_id], references: [id], onDelete: Cascade)
  upload    Upload         @relation(fields: [upload_id], references: [id], onDelete: Cascade)

  @@map("season_files")
}

model SeasonTranslation {
  id                Int         @id @default(autoincrement())
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
  title             String
  season_id         Int
  language          AppLanguage
  short_description String
  season            Season      @relation(fields: [season_id], references: [id], onDelete: Cascade)

  @@map("season_translation")
}

model Episode {
  id             Int                  @id @default(autoincrement())
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  season_id      Int
  movie_id       Int
  dislikes_count Int                  @default(0)
  likes_count    Int                  @default(0)
  watches_count  Int                  @default(0)
  order          Int
  slug           String               @unique
  comments       Comment[]
  files          EpisodeFile[]
  translations   EpisodeTranslation[]
  movie          Movie                @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  season         Season               @relation(fields: [season_id], references: [id], onDelete: Cascade)
  sectionMovies  SectionMovie[]
  user_movies    UserMovie[]

  @@map("episodes")
}

model EpisodeFile {
  id               Int             @id @default(autoincrement())
  episode_id       Int
  upload_id        Int
  type             EpisodeFileType
  intro_duration   Int?
  intro_start_time Int?
  outro_duration   Int?
  episode          Episode         @relation(fields: [episode_id], references: [id], onDelete: Cascade)
  upload           Upload          @relation(fields: [upload_id], references: [id], onDelete: Cascade)

  @@map("episode_files")
}

model EpisodeTranslation {
  id                Int         @id @default(autoincrement())
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
  title             String
  episode_id        Int
  language          AppLanguage
  short_description String
  episode           Episode     @relation(fields: [episode_id], references: [id], onDelete: Cascade)

  @@map("episode_translations")
}

model Comment {
  id             Int               @id @default(autoincrement())
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
  likes_count    Int               @default(0)
  dislikes_count Int               @default(0)
  status         CommentStatus     @default(PENDING)
  entity_type    CommentEntityType
  body           String
  user_id        Int
  episode_id     Int?
  movie_id       Int
  votes          CommentVote[]
  episode        Episode?          @relation(fields: [episode_id], references: [id], onDelete: Cascade)
  movie          Movie             @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("comments")
}

model CommentVote {
  id          Int               @id @default(autoincrement())
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  comment_id  Int
  user_id     Int
  vote_status CommentVoteStatus
  comment     Comment           @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("comment_votes")
}

model Factor {
  id            Int                 @id @default(autoincrement())
  created_at    DateTime            @default(now())
  updated_at    DateTime            @updatedAt
  slug          String              @unique
  files         FactorFile[]
  translations  FactorTranslation[]
  movie_factors MovieFactor[]

  @@map("factors")
}

model FactorFile {
  id        Int            @id @default(autoincrement())
  factor_id Int
  upload_id Int
  type      FactorFileType
  factor    Factor         @relation(fields: [factor_id], references: [id], onDelete: Cascade)
  upload    Upload         @relation(fields: [upload_id], references: [id], onDelete: Cascade)

  @@map("factor_files")
}

model FactorTranslation {
  id         Int         @id @default(autoincrement())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  first_name String
  last_name  String
  factor_id  Int
  language   AppLanguage
  factor     Factor      @relation(fields: [factor_id], references: [id], onDelete: Cascade)

  @@map("factor_translations")
}

model MovieFactor {
  id           Int                      @id @default(autoincrement())
  created_at   DateTime                 @default(now())
  updated_at   DateTime                 @updatedAt
  movie_id     Int
  factor_id    Int
  role_id      Int
  order        Int
  translations MovieFactorTranslation[]
  factor       Factor                   @relation(fields: [factor_id], references: [id], onDelete: Cascade)
  movie        Movie                    @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  role         Role                     @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([movie_id, order])
  @@map("movie_factors")
}

model MovieFactorTranslation {
  id              Int         @id @default(autoincrement())
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  role_name       String
  movie_factor_id Int
  language        AppLanguage
  movie_factor    MovieFactor @relation(fields: [movie_factor_id], references: [id], onDelete: Cascade)

  @@map("movie_factor_translations")
}

model Role {
  id            Int               @id @default(autoincrement())
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  slug          String            @unique
  type          RoleType
  movie_factors MovieFactor[]
  translations  RoleTranslation[]

  @@map("roles")
}

model RoleTranslation {
  id         Int         @id @default(autoincrement())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  name       String
  role_id    Int
  language   AppLanguage
  role       Role        @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@map("role_translations")
}

model Genre {
  id           Int                @id @default(autoincrement())
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  slug         String             @unique
  translations GenreTranslation[]
  movies       MovieGenre[]

  @@map("genres")
}

model GenreTranslation {
  id         Int         @id @default(autoincrement())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  name       String
  genre_id   Int
  language   AppLanguage
  genre      Genre       @relation(fields: [genre_id], references: [id], onDelete: Cascade)

  @@map("genre_translations")
}

model MovieGenre {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  genre_id   Int
  movie_id   Int
  genre      Genre    @relation(fields: [genre_id], references: [id], onDelete: Cascade)
  movie      Movie    @relation(fields: [movie_id], references: [id], onDelete: Cascade)

  @@map("movie_genres")
}

model Tag {
  id           Int              @id @default(autoincrement())
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  slug         String           @unique
  movie_tags   MovieTag[]
  translations TagTranslation[]

  @@map("tags")
}

model TagTranslation {
  id         Int         @id @default(autoincrement())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  label      String
  language   AppLanguage
  tag_id     Int
  tag        Tag         @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@map("tag_translations")
}

model MovieTag {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  tag_id     Int
  movie_id   Int
  movie      Movie    @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@map("movie_tags")
}

model Section {
  id              Int                  @id @default(autoincrement())
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt
  slug            String               @unique
  order           Int                  @unique
  selection_mode  SectionSelectionMode
  sort_mode       SectionSortMode?
  period_base     SectionPeriodBase?
  view_mode       SectionViewMode
  section_filters SectionFilter[]
  section_movies  SectionMovie[]
  translations    SectionTranslation[]

  @@map("sections")
}

model SectionFilter {
  id           Int              @id @default(autoincrement())
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  section_id   Int
  filter_key   SectionFilterKey
  filter_value String
  section      Section          @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@map("section_filters")
}

model SectionTranslation {
  id          Int         @id @default(autoincrement())
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  title       String
  description String?
  language    AppLanguage
  section_id  Int
  section     Section     @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@map("section_translations")
}

model SectionMovie {
  id          Int                   @id @default(autoincrement())
  created_at  DateTime              @default(now())
  updated_at  DateTime              @updatedAt
  section_id  Int
  movie_id    Int
  order       Int
  view_mode   SectionMovieViewMode?
  entity_type CommentEntityType
  episode_id  Int?
  episode     Episode?              @relation(fields: [episode_id], references: [id], onDelete: Cascade)
  movie       Movie                 @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  section     Section               @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([section_id, movie_id, order])
  @@map("section_movies")
}

model UserMovie {
  id            Int               @id @default(autoincrement())
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  type          UserMovieType
  user_id       Int
  movie_id      Int?
  progress_time Int?
  entity_type   CommentEntityType
  episode_id    Int?
  episode       Episode?          @relation(fields: [episode_id], references: [id], onDelete: Cascade)
  movie         Movie?            @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_movies")
}

model Upload {
  id            Int           @id @default(autoincrement())
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  alt_text      String?
  duration      String?
  file_name     String?
  height        String?
  path          String
  width         String?
  source_type   SourceType
  mime_type     String
  size          Int?
  episode_files EpisodeFile[]
  factor_files  FactorFile[]
  movie_files   MovieFile[]
  season_files  SeasonFile[]

  @@map("uploads")
}

model Contact {
  id              Int           @id @default(autoincrement())
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  status          ContactStatus @default(PENDING)
  answer_message  String?
  is_registered   Boolean
  message         String
  user_email      String
  rejected_detail String?

  @@map("contacts")
}

model RefreshToken {
  id             Int      @id @default(autoincrement())
  user_id        Int
  hashed_refresh String
  created_at     DateTime @default(now())
  expires_at     DateTime
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Otp {
  id           Int       @id @default(autoincrement())
  user_id      Int?
  hashed_otp   String
  created_at   DateTime  @default(now())
  expires_at   DateTime
  otp_attempts Int       @default(0)
  type         OtpType
  used_at      DateTime?
  user_email   String?
  user         User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@index([user_id, used_at])
  @@map("otps")
}

model LoginRequest {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("login_requests")
}

model HeaderMenu {
  id           Int                     @id @default(autoincrement())
  created_at   DateTime                @default(now())
  updated_at   DateTime                @updatedAt
  menu_type    HeaderMenuType
  order        Int
  parent_id    Int?
  href         String?
  filters      HeaderMenuFilter[]
  translations HeaderMenuTranslation[]
  parent       HeaderMenu?             @relation("ParentMenu", fields: [parent_id], references: [id], onDelete: Cascade)
  children     HeaderMenu[]            @relation("ParentMenu")

  @@map("header_menus")
}

model HeaderMenuTranslation {
  id         Int         @id @default(autoincrement())
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  language   AppLanguage
  title      String
  menu_id    Int
  menu       HeaderMenu  @relation(fields: [menu_id], references: [id], onDelete: Cascade)

  @@map("header_menu_translations")
}

model HeaderMenuFilter {
  id           Int              @id @default(autoincrement())
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  filter_key   SectionFilterKey
  filter_value String
  menu_id      Int
  menu         HeaderMenu       @relation(fields: [menu_id], references: [id], onDelete: Cascade)

  @@map("header_menu_filters")
}

model PushSubscription {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

view pg_stat_statements_info {
  dealloc     BigInt?
  stats_reset DateTime? @db.Timestamptz(6)
}

view pg_stat_statements {
  userid                 Int?      @db.Oid
  dbid                   Int?      @db.Oid
  toplevel               Boolean?
  queryid                BigInt?
  query                  String?
  plans                  BigInt?
  total_plan_time        Float?
  min_plan_time          Float?
  max_plan_time          Float?
  mean_plan_time         Float?
  stddev_plan_time       Float?
  calls                  BigInt?
  total_exec_time        Float?
  min_exec_time          Float?
  max_exec_time          Float?
  mean_exec_time         Float?
  stddev_exec_time       Float?
  rows                   BigInt?
  shared_blks_hit        BigInt?
  shared_blks_read       BigInt?
  shared_blks_dirtied    BigInt?
  shared_blks_written    BigInt?
  local_blks_hit         BigInt?
  local_blks_read        BigInt?
  local_blks_dirtied     BigInt?
  local_blks_written     BigInt?
  temp_blks_read         BigInt?
  temp_blks_written      BigInt?
  shared_blk_read_time   Float?
  shared_blk_write_time  Float?
  local_blk_read_time    Float?
  local_blk_write_time   Float?
  temp_blk_read_time     Float?
  temp_blk_write_time    Float?
  wal_records            BigInt?
  wal_fpi                BigInt?
  wal_bytes              Decimal?  @db.Decimal
  jit_functions          BigInt?
  jit_generation_time    Float?
  jit_inlining_count     BigInt?
  jit_inlining_time      Float?
  jit_optimization_count BigInt?
  jit_optimization_time  Float?
  jit_emission_count     BigInt?
  jit_emission_time      Float?
  jit_deform_count       BigInt?
  jit_deform_time        Float?
  stats_since            DateTime? @db.Timestamptz(6)
  minmax_stats_since     DateTime? @db.Timestamptz(6)
}

enum UserRole {
  USER
  ADMIN
}

enum MovieType {
  CINEMATIC
  SERIES
}

enum AppLanguage {
  FA
  EN
  AR
}

enum CommentStatus {
  APPROVED
  REJECTED
  PENDING
}

enum CommentEntityType {
  MOVIE
  EPISODE
}

enum UserMovieType {
  BOOKMARK
  LIKE
  DISLIKE
  WATCHING
  WATCHED
  NOTIFICATION
}

enum ContactStatus {
  PENDING
  ANSWERED
  REJECTED
}

enum MovieFileType {
  POSTER
  BANNER
  THUMBNAIL
  TRAILER
  FILM
}

enum SeasonFileType {
  POSTER
  TRAILER
}

enum EpisodeFileType {
  POSTER
  TRAILER
  COVER
  FILM
}

enum FactorFileType {
  PROFILE
}

enum OtpType {
  LOGIN
  FORGET_PASSWORD
  SIGNUP
}

enum SourceType {
  FROM_FILE
  FROM_URL
}

enum RoleType {
  CREATOR
  ACTOR
  DIRECTOR
  PRESENTER
}

enum SectionSelectionMode {
  AUTO
  USER_MOVIE
  MANUAL
  SUGGESTION
}

enum SectionViewMode {
  NORMAL_SLIDER
  KIDS_SLIDER
  HERO_LIKE_SLIDER
  PUZZLE
  ADVERTISEMENT
  HERO
}

enum SectionSortMode {
  NEWEST
  OLDEST
  MOST_VIEWED
  TOP_RATED
  TRENDING
  RANDOM
}

enum SectionPeriodBase {
  A_DAY_AGO
  A_WEEK_AGO
  A_MONTH_AGO
}

enum SectionMovieViewMode {
  PUZZLE
  SLIDER_ITEM
}

enum SectionFilterKey {
  SEARCH
  GENRES
  AGE_LIMITS
  COUNTRIES
  TAGS
  LANGUAGES
  TYPE
  RELEASED_YEAR_FROM
  RELEASED_YEAR_TO
}

enum CommentVoteStatus {
  LIKE
  DISLIKE
}

enum HeaderMenuType {
  PAGE
  FILTER
}

enum TargetMovieType {
  WATCHING
  CONTINUE
  WATCHED
  WATCH
  REWATCH
}
